# ROBOLENS Environment Configuration Template
# Copy this file to .env before starting services

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=robolens_super_secret_jwt_key_change_in_production_32charsmin
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# FastAPI Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# PostgreSQL Database
POSTGRES_USER=robolens_user
POSTGRES_PASSWORD=robolens_password
POSTGRES_DB=robolens
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://robolens_user:robolens_password@localhost:5432/robolens
# Fallback SQLite for local testing without docker:
# DATABASE_URL=sqlite:///./robolens.db

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 Object Storage
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_RAW=robolens-raw-media
S3_BUCKET_PROCESSED=robolens-processed-media
S3_BUCKET_DATASETS=robolens-datasets
S3_PRESIGNED_URL_EXPIRE_SECONDS=3600

# Temporal Workflow Engine
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
